generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String   @default("Admin")
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  phone     String   @default("")
  country   String   @default("RU")
  city      String   @default("")
  zipCode   String   @default("")
  street    String   @default("")
  house     String   @default("")
  apartment String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  favorites Favorite[]
}

model Product {
  id            String         @id @default(uuid())
  name          String
  nameRu        String?        // Russian name
  slug          String         @unique
  description   String
  descriptionRu String?        // Russian description
  price         Float
  shippingFee   Float          @default(0) // Per-product delivery fee in RUB
  oldPrice      Float?         // Original price (for discount display)
  discount      Int            @default(0) // Discount percentage 0-100
  currency      String         @default("RUB")
  image         String
  images        String         @default("[]") // JSON array of image URLs
  stock         Int            @default(0) // Quantity in stock
  inStock       Boolean        @default(true)
  isPreorder            Boolean    @default(false)
  preorderClosed        Boolean    @default(false)  // предзаказ закрыт
  preorderAvailableDate DateTime?                   // дата открытия продажи (отображается в сообщении)
  isAuthor      Boolean        @default(false) // авторская колода
  isLimited          Boolean        @default(false) // лимитированный тираж
  limitedEditionText   String         @default("")
  limitedEditionTextEn String         @default("")
  noticeText         String         @default("") // Per-product notice/badge text (RU)
  noticeTextEn       String         @default("") // Per-product notice/badge text (EN)
  shippingConditions String         @default("[]") // JSON [{fromQty,toQty,price}] tiered shipping
  isActive           Boolean        @default(true) // Show in catalog
  isAvailable        Boolean        @default(true) // Can be purchased (add to cart enabled)
  isSaleDisabled     Boolean        @default(false) // "Скоро" — товар в каталоге, кнопка "Скоро"
  isSoldOut          Boolean        @default(false) // Плашка "Sold Out" на фото
  characteristics    String         @default("") // JSON array of {key, value} pairs
  colors            String         @default("[]") // JSON array of {name, hex} color options
  avitoUrl      String         @default("") // link to avito listing if parsed
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orderItems    OrderItem[]
  favorites     Favorite[]
  avitoProducts AvitoProduct[]
  waitlistRequests WaitlistRequest[]
  reviews       Review[]
  reviewInvites ReviewInvite[]
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  customerName    String
  customerEmail   String
  customerPhone   String      @default("")
  country         String      @default("RU")
  oblast          String      @default("")  // region / oblast
  city            String      @default("")
  zipCode         String      @default("")
  street          String      @default("")
  house           String      @default("")
  apartment       String      @default("")
  shippingMethod  String      @default("") // ozon, yandex, pochta_ru, cdek, pochta_int
  status          String      @default("assembling") // assembling, shipped, in_transit, delivered, cancelled
  paymentMethod   String      @default("") // yukassa, stripe, apple_pay, google_pay
  paymentId       String      @default("")
  totalAmount     Float
  currency        String      @default("RUB")
  notes           String      @default("")
  isManual        Boolean     @default(false) // created manually by admin
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  productId     String
  quantity      Int
  price         Float
  selectedColor String  @default("")
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id])
}

model SiteContent {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   // JSON content
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id           String   @id @default(uuid())
  filename     String
  relativePath String   @unique
  url          String
  data         Bytes?
  size         Int      @default(0)
  width        Int      @default(0)
  height       Int      @default(0)
  mimeType     String   @default("image/webp")
  source       String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([deletedAt, updatedAt])
  @@index([source, updatedAt])
}

model ReviewInvite {
  id           String    @id @default(uuid())
  tokenHash    String    @unique
  tokenPreview String    @default("")
  email        String
  customerName String    @default("")
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  status       String    @default("sent") // sent, used, revoked, expired
  sentAt       DateTime  @default(now())
  expiresAt    DateTime?
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  review       Review?

  @@index([email, createdAt])
  @@index([productId, createdAt])
  @@index([status, createdAt])
}

model Review {
  id           String       @id @default(uuid())
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  inviteId     String       @unique
  invite       ReviewInvite @relation(fields: [inviteId], references: [id], onDelete: Restrict)
  customerEmail String
  customerName String       @default("")
  rating       Float
  text         String       @default("")
  media        String       @default("[]") // JSON array of images/videos
  status       String       @default("pending") // pending, approved, rejected
  ip           String       @default("")
  userAgent    String       @default("")
  approvedAt   DateTime?
  rejectedAt   DateTime?
  moderatedBy  String       @default("")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([productId, status, createdAt])
  @@index([customerEmail, createdAt])
  @@index([status, createdAt])
}

// ─── Analytics ───

model PageView {
  id        String   @id @default(uuid())
  sessionId String
  path      String
  referrer  String   @default("")
  userAgent String   @default("")
  ip        String   @default("")
  country   String   @default("")
  city      String   @default("")
  lang      String   @default("")
  duration  Int      @default(0)  // seconds on page
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@index([ip])
  @@index([country])
}

model DailyStat {
  id         String   @id @default(uuid())
  date       String   @unique  // YYYY-MM-DD
  views      Int      @default(0)
  visitors   Int      @default(0)
  orders     Int      @default(0)
  revenue    Float    @default(0)
  createdAt  DateTime @default(now())
}

// ─── Inquiries / Contact Form ───

model Inquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String   @default("")
  message   String
  status    String   @default("new") // new, read, replied, closed
  notes     String   @default("")
  source    String   @default("contact_form") // contact_form, avito, email, etc.
  ip        String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WaitlistRequest {
  id          String   @id @default(uuid())
  productId   String?  
  product     Product? @relation(fields: [productId], references: [id])
  productSlug String
  productName String
  requestTag  String   @default("")
  name        String
  email       String
  consentPersonalData Boolean @default(false)
  selectedColor String  @default("")
  status      String   @default("pending")
  notifiedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Avito Integration ───

model AvitoProduct {
  id          String   @id @default(uuid())
  avitoId     String   @unique
  title       String
  price       Float
  currency    String   @default("RUB")
  description String
  images      String   @default("[]") // JSON array
  category    String   @default("")
  status      String   @default("active") // active, sold, inactive
  syncedAt    DateTime @default(now())
  productId   String?  // linked local product
  product     Product? @relation(fields: [productId], references: [id])
  rawData     String   @default("{}") // full JSON from Avito
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomPage {
  id          String   @id @default(uuid())
  title       String
  titleRu     String   @default("")
  slug        String   @unique
  content     String
  contentRu   String   @default("")
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Expenses ───

model Expense {
  id          String   @id @default(uuid())
  amount      Float
  description String
  category    String   @default("") // e.g. shipping, packaging, marketing, other
  date        String   // YYYY-MM-DD
  createdAt   DateTime @default(now())
}

// ─── Admin Email ───

model AdminEmail {
  id        String   @id @default(uuid())
  direction String   @default("outbound") // inbound, outbound
  fromAddr  String
  toAddr    String
  subject   String   @default("")
  body      String   // HTML body
  textBody  String   @default("") // Plain text body
  status    String   @default("sent") // sent, delivered, failed, received
  isRead    Boolean  @default(false)
  resendId  String   @default("") // Resend message ID
  inReplyTo String   @default("") // Parent email ID for threading
  inquiryId String   @default("") // linked inquiry, if any
  createdAt DateTime @default(now())
}
